{
  "name": "@blitzd/panels-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:changelog": "bun scripts/generate-changelog-feeds.ts",
    "generate:aeo": "bun scripts/generate-aeo-assets.ts",
    "prerender": "bun scripts/prerender.mjs",
    "dev": "bun run generate:changelog && bun run generate:aeo && vite",
    "build": "bun run generate:changelog && bun run generate:aeo && tsc -b && vite build && bun run prerender",
    "typecheck": "tsc -b",
    "check:docs-coverage": "node scripts/check-docs-coverage.mjs",
    "check:docs-props": "node scripts/check-docs-props.mjs",
    "check:docs": "bun run check:docs-coverage && bun run check:docs-props",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@blitzd/resizable-panels": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.13.0",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.59.1",
    "remark-gfm": "^4.0.1",
    "serve-handler": "^6.1.6",
    "typescript": "~6.0.2",
    "vite": "8.0.16"
  }
}
